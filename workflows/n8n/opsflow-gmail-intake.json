        "id": "8c000000-0000-4000-8000-000000000002",
        "name": "Prepare Gmail Provenance",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.5,
        "position": [
          220,
          0
        ]
      },
      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "language": "javaScript",
          "jsCode": "const item = $input.item;\nconst binary = $input.item.binary ?? {};\nconst supported = Object.keys(binary)\n  .filter((key) => key.startsWith('attachment_'))\n  .map((key) => ({ key, file: binary[key] }))\n  .filter(({ file }) => !String(file.mimeType ?? '').toLowerCase().startsWith('image/'))\n  .map(({ key, file }) => {\n    const match = String(file.fileName ?? '').match(/\\.(pdf|xlsx|csv)$/i);\n    if (!match) return null;\n    const extension = match[1].toLowerCase();\n    const canonical = {\n      pdf: { documentType: 'PDF', documentMimeType: 'application/pdf' },\n      xlsx: { documentType: 'XLSX', documentMimeType: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' },\n      csv: { documentType: 'CSV', documentMimeType: 'text/csv' },\n    }[extension];\n    return { key, file, ...canonical };\n  })\n  .filter((candidate) => candidate !== null);\nconst selected = supported.length === 1 ? supported[0] : null;\nconst outputBinary = { ...binary };\nif (selected) outputBinary.document = { ...selected.file, mimeType: selected.documentMimeType };\nelse delete outputBinary.document;\nreturn {\n  json: {\n    ...item.json,\n    supportedAttachmentCount: supported.length,\n    sourceKind: supported.length > 1 ? 'AMBIGUOUS_SUPPORTED_ATTACHMENTS' : selected ? 'ATTACHMENT' : 'BODY_FALLBACK',\n    documentType: selected?.documentType ?? null,\n    documentName: selected?.file.fileName ?? null,\n    documentMimeType: selected?.documentMimeType ?? null,\n  },\n  binary: outputBinary,\n};"
        },
